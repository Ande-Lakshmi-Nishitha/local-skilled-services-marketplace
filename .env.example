# Copy this file to .env  (PowerShell:  Copy-Item .env.example .env)
# Both the web app and the npm scripts read .env. Never commit .env.

# ---- databases (these match docker-compose.yml) ----
POSTGRES_URL=postgres://skillmarket:skillmarket@127.0.0.1:5432/skillmarket
MONGODB_URI=mongodb://127.0.0.1:27017/skillmarket

# ---- sign-in cookie: any long random string ----
SESSION_SECRET=change-me-to-a-long-random-string-1234567890

# ---- embedding model ----
# transformers = real semantic model (all-MiniLM-L6-v2, 384 dims), downloaded once (~90 MB) into .hf-cache
# hash         = offline fallback if the download is blocked on your network (NOT semantic, demo only)
EMBEDDING_PROVIDER=transformers
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DTYPE=fp32
EMBEDDING_DIM=384
# If huggingface.co is blocked, a mirror sometimes works:
# HF_REMOTE_HOST=https://hf-mirror.com/

# ---- matching knobs (tuned with: npm run eval -- --grid) ----
MATCH_ALPHA=0.7
MATCH_MIN_SIMILARITY=0.25
MATCH_ANN_CANDIDATES=100
