# Copy to .env (root, used by docker-compose + scripts) and to web/.env.local (used by Next.js)

# --- Infra ---
POSTGRES_USER=skillmarket
POSTGRES_PASSWORD=skillmarket
POSTGRES_DB=skillmarket
PG_PORT=5432
MONGO_PORT=27017
MONGO_DB=skillmarket

# --- App connection strings ---
POSTGRES_URL=postgres://skillmarket:skillmarket@localhost:5432/skillmarket
MONGODB_URI=mongodb://localhost:27017/skillmarket

# --- Auth (demo identity picker, see docs/04-decisions-and-er-changes.md D5) ---
SESSION_SECRET=change-me-to-a-long-random-string

# --- Embeddings (Person B). DIM must match vector(384) in db/postgres/migrations/002_vector.sql ---
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Matching knobs (Person B) ---
MATCH_ALPHA=0.7              # weight of similarity vs trust (rating) in the final score
MATCH_MIN_SIMILARITY=0.25    # drop matches below this cosine similarity; tune with the eval set
MATCH_ANN_CANDIDATES=100     # how many embedding rows the ANN stage fetches before filtering
